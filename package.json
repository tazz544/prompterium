{
  "name": "prompterium",
  "version": "0.1.5",
  "description": "Cursor project skills, rules, hooks, and templates — sync catalog into .cursor/",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prompterium": "./dist/bin/prompterium.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./catalog/*": "./catalog/*"
  },
  "files": [
    "dist",
    "catalog",
    "scripts/sync.sh"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "sync": "node dist/bin/prompterium.js sync .",
    "prepare": "npm run build",
    "prepack": "npm run build && node dist/bin/prompterium.js sync --dry-run ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tazz544/Prompterium.git"
  },
  "keywords": [
    "cursor",
    "skills",
    "prompts",
    "agent",
    "templates"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
